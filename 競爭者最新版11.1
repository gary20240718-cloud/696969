local function isTeammate_R(player)
    if player == LocalPlayer then return true end
    if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then return true end
    return false
end

local lastUpdate = 0

RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    -- 即時同步全域變數到雷達 UI
    if RadarGui then
        RadarGui.Visible = _G.RadarEnabled
        RadarGui.Size = UDim2.new(0, _G.RadarSize, 0, _G.RadarSize)
        RadarGui.Position = UDim2.new(0, _G.RadarX, 0, _G.RadarY)
    end

    -- 物理：飛天
    if isFlying and bodyVelocity then
        local moveVector = Vector3.new(0, 0, 0)
        local playerModule = LocalPlayer:FindFirstChild("PlayerScripts"):FindFirstChild("PlayerModule")
        if playerModule then
            local controls = require(playerModule):GetControls(); local moveVectorInput = controls:GetMoveVector()
            if moveVectorInput.Magnitude > 0 then moveVector = (Camera.CFrame.LookVector * -moveVectorInput.Z) + (Camera.CFrame.RightVector * moveVectorInput.X) end
        end
        if moveVector.Magnitude > 0 then bodyVelocity.Velocity = moveVector.Unit * 60 else bodyVelocity.Velocity = Vector3.new(0, 0.1, 0) end
        
        for _, p in pairs(char:GetChildren()) do 
            if p:IsA("BasePart") then p.CanCollide = not isNoclip end 
        end
    end

    -- 物理：瞬移
    if isTPEnabled then
        for _, p in pairs(char:GetChildren()) do 
            if p:IsA("BasePart") then p.CanCollide = false end 
        end

        local closestPlayer, closestDist = nil, 1000
        for _, p in ipairs(Players:GetPlayers()) do
            if not isTeammate_R(p) and p.Character then
                local root = p.Character:FindFirstChild("HumanoidRootPart"); local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if root and hum and hum.Health > 0 then
                    local dist = (myRoot.Position - root.Position).Magnitude
                    if dist < closestDist then closestDist = dist; closestPlayer = p end
                end
            end
        end
        if closestPlayer and closestPlayer.Character and closestPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local enemyRoot = closestPlayer.Character.HumanoidRootPart; local targetPos
            if tpDistance == 25 then targetPos = enemyRoot.Position + Vector3.new(0, 10, 0) 
            elseif tpDistance == 5 then targetPos = enemyRoot.Position + Vector3.new(0, 3.5, 0) 
            else targetPos = enemyRoot.Position + (enemyRoot.CFrame.LookVector * tpDistance) end
            myRoot.CFrame = CFrame.new(targetPos, enemyRoot.Position) 
        end
    end

    if not isESPEnabled then
        for obj, data in pairs(ESP_Objects) do if data.billboard then data.billboard:Destroy() end end
        ESP_Objects = {}
        for _, line in pairs(TracerLines) do line.Visible = false end
        if RadarGui then RadarGui.Visible = false end
        return
    end

    local tick = tick()
    if tick - lastUpdate < 0.05 then return end
    lastUpdate = tick

    -- 掃描敵人
    local validEnemies = {}
    local processedModels = {}

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= char then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local plr = Players:GetPlayerFromCharacter(obj)
            local targetPart = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head") or obj:FindFirstChildWhichIsA("BasePart")
            
            if (hum or plr) and targetPart then
                if not processedModels[obj] then
                    processedModels[obj] = true
                    local isEnemy = true
                    if plr and isTeammate_R(plr) then isEnemy = false end
                    if not isShowNPC and not plr then isEnemy = false end

                    if isEnemy then
                        local dist = (myRoot.Position - targetPart.Position).Magnitude
                        if dist <= drawDistance then 
                            table.insert(validEnemies, {head = targetPart, dist = dist, hum = hum, plr = plr}) 
                        end
                    end
                end
            end
        end
    end

    table.sort(validEnemies, function(a, b) return a.dist < b.dist end)

    local currentEnemiesMap = {}
    for _, target in ipairs(validEnemies) do currentEnemiesMap[target.head] = true end

    for obj, data in pairs(ESP_Objects) do
        if not currentEnemiesMap[obj] and data.billboard then
            data.billboard.Enabled = false
        end
    end

    -- 更新或建立 3D 透視 UI
    for _, target in ipairs(validEnemies) do
        local obj, dist, hum, plr = target.head, target.dist, target.hum, target.plr

        if not ESP_Objects[obj] or not ESP_Objects[obj].billboard.Parent then
            local billboard = Instance.new("BillboardGui"); 
            billboard.Size = UDim2.new(0, 160, 0, 60); 
            billboard.StudsOffset = Vector3.new(0, 3, 0); 
            billboard.AlwaysOnTop = true; 
            billboard.Adornee = obj; 
            billboard.ZIndexBehavior = Enum.ZIndexBehavior.Global
            billboard.Parent = obj

            local nameLabel = Instance.new("TextLabel"); nameLabel.Name = "NameLabel"; nameLabel.Size = UDim2.new(1, 0, 0.4, 0); nameLabel.Position = UDim2.new(0, 0, 0, 0); nameLabel.BackgroundTransparency = 1; nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255); nameLabel.TextStrokeTransparency = 0; nameLabel.TextScaled = false; nameLabel.Font = Enum.Font.SourceSansBold; nameLabel.ZIndex = 5; nameLabel.Parent = billboard
            
            local hpLabel = Instance.new("TextLabel"); hpLabel.Name = "HpLabel"; hpLabel.Size = UDim2.new(1, 0, 0.3, 0); hpLabel.Position = UDim2.new(0, 0, 0.4, 0); hpLabel.BackgroundTransparency = 1; hpLabel.TextColor3 = Color3.fromRGB(0, 255, 0); hpLabel.TextStrokeTransparency = 0; hpLabel.TextScaled = false; hpLabel.Font = Enum.Font.SourceSansBold; hpLabel.ZIndex = 5; hpLabel.Parent = billboard
            
            local healthBg = Instance.new("Frame"); healthBg.Name = "HealthBg"; healthBg.Size = UDim2.new(0, healthBarWidth, 0.8, 0); healthBg.Position = UDim2.new(0.5, -80, 0.1, 0); healthBg.BackgroundColor3 = Color3.fromRGB(30, 30, 30); healthBg.ZIndex = 3; healthBg.Parent = billboard
            local HBCorner = Instance.new("UICorner") HBCorner.CornerRadius = UDim.new(0, 2) HBCorner.Parent = healthBg
            
            local healthBar = Instance.new("Frame"); healthBar.Name = "HealthBar"; healthBar.Size = UDim2.new(1, 0, 1, 0); healthBar.BackgroundColor3 = Color3.fromRGB(0, 255, 0); healthBar.ZIndex = 4; healthBar.Parent = healthBg
            local HBarCorner = Instance.new("UICorner") HBarCorner.CornerRadius = UDim.new(0, 2) HBarCorner.Parent = healthBar
            
            ESP_Objects[obj] = { billboard = billboard, nameLabel = nameLabel, hpLabel = hpLabel, healthBar = healthBar, healthBg = healthBg }
        end

        local ui = ESP_Objects[obj]
        if ui and ui.billboard and ui.billboard.Parent then
            ui.nameLabel.TextSize = textSize; 
            ui.hpLabel.TextSize = math.max(textSize - 2, 8); 
            ui.healthBg.Size = UDim2.new(0, healthBarWidth, 0.8, 0)

            local nameStr = plr and plr.Name or "假人 (NPC)"
            local showNameText = isShowName and nameStr or ""
            local showDistText = isShowDist and ("[" .. math.floor(dist) .. "m]") or ""
            ui.nameLabel.Text = showNameText .. " " .. showDistText
            ui.nameLabel.Visible = (isShowName or isShowDist) 
            
            if hum then
                local hp = math.floor(hum.Health); 
                local maxHp = hum.MaxHealth
                if maxHp <= 0 then maxHp = 150 end
                
                if isShowHP then ui.hpLabel.Text = hp .. " HP"; ui.hpLabel.Visible = true else ui.hpLabel.Visible = false end
                local ratio = math.clamp(hp / maxHp, 0, 1)
                ui.healthBar.Size = UDim2.new(1, 0, ratio, 0)
                ui.healthBg.Visible = isShowHealthBar 
                
                if ratio < 0.3 then ui.healthBar.BackgroundColor3 = Color3.fromRGB(255, 0, 0); ui.hpLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
                else ui.healthBar.BackgroundColor3 = Color3.fromRGB(0, 255, 0); ui.hpLabel.TextColor3 = Color3.fromRGB(0, 255, 0) end
            else 
                ui.hpLabel.Text = "無敵 (NPC)" 
                ui.healthBar.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                ui.hpLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                ui.healthBg.Visible = isShowHealthBar
            end
            ui.billboard.Enabled = true
        end
    end

    -- 射線渲染
    local screenSize = Camera.ViewportSize; local screenCenterX = screenSize.X / 2; local screenTopY = 0

    if isTracerEnabled then
        for i = 1, maxTracerLines do
            local target = validEnemies[i]
            if target then
                local line = TracerLines[i]
                local screenPos, onScreen = Camera:WorldToViewportPoint(target.head.Position)
                if onScreen then 
                    line.From = Vector2.new(screenCenterX, screenTopY)
                    line.To = Vector2.new(screenPos.X, screenPos.Y)
                    line.Visible = true 
                else line.Visible = false end
            else if TracerLines[i] then TracerLines[i].Visible = false end end
        end
    else
        for _, line in pairs(TracerLines) do line.Visible = false end
    end

    -- ==================== 雷達繪製邏輯 (相機視角 + 完美防重疊排版) ====================
    for _, dot in pairs(RadarDots) do if dot and dot.Parent then dot.Visible = false end end
    local dotIndex = 1

    if _G.RadarEnabled and RadarGui and RadarGui.Visible then
        for _, plr in ipairs(Players:GetPlayers()) do
            if not isTeammate_R(plr) and plr.Character then
                local root = plr.Character:FindFirstChild("HumanoidRootPart")
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                if root and hum and hum.Health > 0 then
                    local relativePos = Camera.CFrame:PointToObjectSpace(root.Position)
                    local dist = Vector3.new(relativePos.X, 0, relativePos.Z).Magnitude
                    
                    if dist <= _G.RadarDistance then
                        local radarScale = _G.RadarSize / (_G.RadarDistance * 2)
                        local px = (relativePos.X * radarScale)
                        local py = (-relativePos.Z * radarScale)
                        
                        local maxRadius = _G.RadarSize / 2 - 5
                        local rDist = math.sqrt(px*px + py*py)
                        if rDist > maxRadius then
                            local scale = maxRadius / rDist
                            px = px * scale
                            py = py * scale
                        end

                        local dot = RadarDots[dotIndex]
                        if not dot then
                            dot = Instance.new("Frame")
                            dot.Size = UDim2.new(0, 6, 0, 6)
                            dot.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
                            dot.ZIndex = 5
                            dot.Parent = RadarGui
                            
                            local dotCorner = Instance.new("UICorner") dotCorner.CornerRadius = UDim.new(1, 0) dotCorner.Parent = dot
                            
                            local barBg = Instance.new("Frame")
                            barBg.Size = UDim2.new(0, 10, 0, 2)
                            barBg.Position = UDim2.new(0, -2, 0, -4)
                            barBg.BackgroundColor3 = Color3.fromRGB(30,30,30)
                            barBg.ZIndex = 4
                            barBg.Parent = dot
                            
                            local barFill = Instance.new("Frame")
                            barFill.Size = UDim2.new(1, 0, 1, 0)
                            barFill.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
                            barFill.ZIndex = 5
                            barFill.Parent = barBg
                            
                            -- 【修改】距離文字放到紅點正下方，並縮小字體
                            local distText = Instance.new("TextLabel")
                            distText.Size = UDim2.new(0, 30, 0, 10)
                            distText.Position = UDim2.new(0.5, -15, 1, 2) -- 置中並往下移
                            distText.BackgroundTransparency = 1
                            distText.TextColor3 = Color3.fromRGB(255, 255, 255)
                            distText.TextStrokeTransparency = 0.5
                            distText.Font = Enum.Font.SourceSansBold
                            distText.TextSize = 9 -- 字體縮小
                            distText.ZIndex = 6
                            distText.Parent = dot

                            table.insert(RadarDots, dot)
                        end
                        
                        dot.Visible = true
                        dot.Position = UDim2.new(0.5, px - 3, 0.5, py - 3)
                        
                        local bar = dot:FindFirstChildOfClass("Frame")
                        local fill = bar and bar:FindFirstChildOfClass("Frame")
                        if fill then fill.Size = UDim2.new(hum.Health / hum.MaxHealth, 0, 1, 0) end
                        
                        -- 更新距離文字
                        local txt = dot:FindFirstChildOfClass("TextLabel")
                        if txt then txt.Text = math.floor(dist) .. "m" end
                        
                        dotIndex = dotIndex + 1
                    end
                end
            end
        end
    end
end)
