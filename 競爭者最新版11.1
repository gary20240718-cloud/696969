createSwitch(Page2, "穿牆", 0.05, 5, isNoclip, function(state) isNoclip = state end)
flySwitch = createSwitch(Page2, "飛天模式", 0.53, 5, isFlying, function(state)
    isFlying = state
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid"); local root = char:FindFirstChild("HumanoidRootPart")
    if not root or not hum then return end
    if isFlying then
        isTPEnabled = false; if tpSwitch then tpSwitch.setState(false) end
        pcall(function() root:SetNetworkOwner(LocalPlayer) end)
        hum.PlatformStand = true
        bodyVelocity = Instance.new("BodyVelocity"); bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge); bodyVelocity.Parent = root
    else
        hum.PlatformStand = false
        if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end
        for _, p in pairs(char:GetChildren()) do if p:IsA("BasePart") then p.CanCollide = true end end
    end
end)
tpSwitch = createSwitch(Page2, "瞬移追擊", 0.05, 40, isTPEnabled, function(state)
    isTPEnabled = state
    if isTPEnabled then
        isFlying = false; if flySwitch then flySwitch.setState(false) end
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.PlatformStand = false
                if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end
            end
        end
    end
end)

local function createTPDistBtn(text, posX, posY, dist)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.18, 0, 0, 25); btn.Position = UDim2.new(posX, 0, 0, posY)
    btn.BackgroundColor3 = (tpDistance == dist) and Color3.fromRGB(0, 150, 255) or Color3.fromRGB(40, 45, 55)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255); btn.Text = text; btn.Font = Enum.Font.SourceSans; btn.TextSize = 13; btn.Parent = Page2
    btn.MouseButton1Click:Connect(function()
        tpDistance = dist
        for _, child in pairs(Page2:GetChildren()) do 
            if child:IsA("TextButton") and (child.Text == "2m" or child.Text == "5m" or child.Text == "25m") then 
                TweenService:Create(child, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 45, 55)}):Play()
            end 
        end
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(0, 150, 255)}):Play()
    end)
end
